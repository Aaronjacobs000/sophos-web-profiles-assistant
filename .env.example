# Web Profiles Assistant: environment configuration
#
# The setup wizard and the Credentials page write this file. You can also edit
# it by hand; restart the server after a manual edit.

# ---- Server ----
PORT=3110
# Address to listen on. 127.0.0.1, the default, is this computer only.
# 0.0.0.0 (every IPv4 network), :: (every network) or one of this computer's
# addresses lets other machines use the tool.
# HOST=127.0.0.1
# When HOST is not 127.0.0.1: the client addresses and CIDR subnets that may
# use the tool, comma-separated, for example 192.168.1.0/24,10.0.0.5.
# This computer is always allowed. Left empty, anyone who can reach the port can.
# ALLOWED_IPS=
# Extra host names the server answers to (a reverse proxy, a .local name).
# ALLOWED_HOSTS=

# ---- Credential mode: "tenant" (one tenant) or "partner" (partner or organization) ----
CREDENTIAL_MODE=tenant

# One tenant: a tenant API credential.
SOPHOS_TENANT_CLIENT_ID=
SOPHOS_TENANT_CLIENT_SECRET=
# The API doesn't return a tenant's name to a tenant credential, so give it one.
SOPHOS_TENANT_LABEL=

# Partner or organization: one credential that reaches many tenants.
SOPHOS_PARTNER_CLIENT_ID=
SOPHOS_PARTNER_CLIENT_SECRET=
SOPHOS_PARTNER_LABEL=

# ---- Estate scan ----
# Tenants read at once in partner mode, 1 to 8. Default 4.
# ESTATE_CONCURRENCY=4

# ---- PDF export ----
# The PDF report is printed by a local Chrome or Edge. Set this when the tool
# can't find one.
# CHROME_PATH=

# ---- Clean up (optional) ----
# SophosLabs Intelix URL lookup credential (AWS Marketplace) and region (au, de or us).
# Set it in the setup wizard or on the Credentials page instead if you prefer.
# INTELIX_CLIENT_ID=
# INTELIX_CLIENT_SECRET=
# INTELIX_REGION=au

# ---- Pilot digest ----
# Hours between SIEM event collections while the server runs, for tenants
# that turned collection on in the pilot step. 1 to 23, default 6; 0 turns
# the timer off (use `npm run collect` from a scheduler instead).
# SIEM_COLLECT_HOURS=6
